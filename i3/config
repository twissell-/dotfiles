# POLYBAR

exec_always --no-startup-id "${HOME}/bin/dotfiles/polybar/launch.sh"

# KEYBINDINGS & EXTRA SCRIPTS

# Volume Keys
bindsym Mod4+equal exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/volume-control.sh up"
bindsym Mod4+minus exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/volume-control.sh down"

# Mune/Unmute
bindsym $mod+c exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/mic-control.sh"
bindsym Ctrl+Escape exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/mic-control.sh"

# Screen Manager
exec_always --no-startup-id "${HOME}/bin/dotfiles/screenlayout/.latest"
bindsym Mod4+Shift+a exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/screen-manager.sh"

# Bluetooth
bindsym Mod4+Shift+b exec --no-startup-id "${HOME}/bin/dotfiles/i3/scripts/rofi-bluetooth.sh"

# bind apps to workspaces
# xprop WM_CLASS

assign [class="vivaldi-stable"] $ws2
assign [class="Vivaldi-stable"] $ws2

assign [class="code"] $ws4
assign [class="Code"] $ws4

assign [class="clockify"] $ws9
assign [class="Clockify"] $ws9
