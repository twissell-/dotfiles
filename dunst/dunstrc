[global]
frame_width = 1
frame_color = "#b4befe"
separator_color= frame
highlight = "#74c7ec"
background = "#222235"
foreground = "#C5C8C6"
corner_radius = 5
progress_bar_corner_radius = 5
corners = top-left,bottom
progress_bar_corners = top-left,bottom-right
# offset = 15x25
gap_size = 5
format = "<b>󰁕 %s (%a)</b>\n<i>%b</i>"

# shortcuts
close = ctrl+space
close_all = ctrl+shift+space
history = ctrl+grave
context = ctrl+period

# ==============================================================

[urgency_low]
foreground = "#a6e3a1"
frame_color = "#a6e3a1"
default_icon = "~/bin/dotfiles/dunst/icons/bell-badge-low.svg"
timeout = 10

[urgency_normal]
foreground = "#74c7ec"
frame_color = "#74c7ec"
default_icon = "~/bin/dotfiles/dunst/icons/bell-badge.svg"
timeout = 10

[urgency_critical]
foreground = "#f38ba8"
frame_color = "#f38ba8"
default_icon = "~/bin/dotfiles/dunst/icons/alert-decagram.svg"
timeout = 0

# ==============================================================

[dba_sl]
summary = *dba*
urgency = critical

[dba_su]
summary = *DBA*
urgency = critical

[dba_st]
summary = *Dba*
urgency = critical

[dba_bl]
body = *dba*
urgency = critical

[dba_bu]
body = *DBA*
urgency = critical

[dba_bt]
body = *Dba*
urgency = critical

[damian_maggio]
body = *damian\.maggio*
urgency = critical

[mic_control]
appname = "mic_control"
timeout = 1
history_ignore = yes
set_stack_tag = "mic_control"

[custom_low]
msg_urgency = low
foreground = "#a6e3a1"
frame_color = "#a6e3a1"
default_icon = "~/bin/dotfiles/dunst/icons/bell-badge-low.svg"
timeout = 10

[custom_normal]
msg_urgency = normal
foreground = "#74c7ec"
frame_color = "#74c7ec"
default_icon = "~/bin/dotfiles/dunst/icons/bell-badge.svg"
timeout = 10

[custom_critical]
msg_urgency = critical
foreground = "#f38ba8"
frame_color = "#f38ba8"
default_icon = "~/bin/dotfiles/dunst/icons/alert-decagram.svg"
timeout = 0

